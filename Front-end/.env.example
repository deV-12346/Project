# Example Environment Variables
# Copy this file to .env.development or .env.production and update the values

# Backend API URL
# For local development: http://localhost:5000
# For production: https://your-backend-url.com
VITE_API_BASE_URL=

# API Timeout (in milliseconds)
VITE_API_TIMEOUT=5000

# Environment Name (development, production, staging)
VITE_APP_ENV=

# Instructions:
# 1. Copy this file: cp .env.example .env.development
# 2. Update VITE_API_BASE_URL with your backend URL
# 3. Never commit .env.development or .env.production to git
# 4. Only .env.example should be committed to version control
